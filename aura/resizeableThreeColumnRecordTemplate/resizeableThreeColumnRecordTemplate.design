<design:component label="Resizable 3-Column Layout">
    <flexipage:template>
        <flexipage:region name="header" defaultWidth="LARGE" />
        <flexipage:region name="left"   defaultWidth="SMALL" />
        <flexipage:region name="center" defaultWidth="LARGE" />
        <flexipage:region name="right"  defaultWidth="SMALL" />
    </flexipage:template>
</design:component>